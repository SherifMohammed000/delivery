rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check for specific roles
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // --- COLLECTION RULES ---

    // Users Collection: Users can read/write their own document. Admins can read all.
    // Allow reading delivery partners so customers can track them.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        hasRole('admin') || 
        resource.data.role == 'delivery'
      );
      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin'));
    }

    // Products Collection: Public read. Admin only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Services Collection: Public read. Admin only write.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Zones Collection: Public read. Admin only write.
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Orders Collection: 
    // - Customers can create and read their own orders.
    // - Admin and Delivery can read all orders.
    // - Delivery can update order status.
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        hasRole('admin') || 
        hasRole('delivery')
      );
      allow update: if isAuthenticated() && (
        hasRole('admin') || 
        (hasRole('delivery') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
    }

    // Delivery Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (hasRole('admin') || hasRole('delivery'));
      allow write: if hasRole('admin');
    }
  }
}
